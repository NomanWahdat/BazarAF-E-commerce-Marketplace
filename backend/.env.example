# Local development only. Copy to backend/.env in a fresh clone.
# Generate your own SECRET_KEY; never reuse this placeholder in a deployed app.
DEBUG=True
SECRET_KEY=replace-with-a-new-random-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Empty selects backend/db.sqlite3. Use only a disposable DB during development.
DATABASE_URL=
REDIS_URL=

# Empty EMAIL_HOST_USER selects console mail. EmailJob still needs a worker.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BazarAF <noreply@example.test>
GOOGLE_CLIENT_ID=

# Optional public S3-compatible media; private documents require a separate bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=bazaraf-demo-public-media
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
PRIVATE_DOCUMENT_BUCKET=

# A valid Fernet key is required in production; generate and store it privately.
FIELD_ENCRYPTION_KEY=
SENTRY_DSN=
ENVIRONMENT=development
